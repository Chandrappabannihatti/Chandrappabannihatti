# Frontend API mode (false = API-first, true = local UI demo)
VITE_DEMO_MODE=false

# Node API
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Set USE_DEMO_DATA=false after MySQL is available
USE_DEMO_DATA=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=camps
DB_USER=camps_app
DB_PASSWORD=change-me

# Optional Flask XGBoost service
ML_SERVICE_URL=http://127.0.0.1:8000

# Report-card branding (logo is optional; PNG/JPG path is read by the Node API)
COLLEGE_NAME=PES Institute of Technology and Management
COLLEGE_LOCATION=Shivamogga, Karnataka
ACADEMIC_YEAR=2026-27
COLLEGE_LOGO_PATH=
